# Copiez ce fichier en `keystore.properties` et complétez-le pour compiler une
# version signée en local. Le vrai fichier est ignoré par git.
#
# Le magasin de clés est irremplaçable : Android refuse de mettre à jour une
# application avec un APK signé par une autre clé. Sauvegardez-le hors de
# cette machine, avec son mot de passe.
storeFile=/chemin/absolu/vers/resonate-release.jks
storePassword=
keyAlias=resonate
keyPassword=
